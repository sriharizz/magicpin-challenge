%% -----------------------------------------------------------------------------
%% 2. /v1/context DATA INGESTION FLOW
%% -----------------------------------------------------------------------------
%% Ingestion Sequence and Version Conflict Handling
%% -----------------------------------------------------------------------------
sequenceDiagram
    autonumber
    actor Judge as Judge / Client
    participant API as app/routes/context.py
    participant Store as app/store/context_store.py
    participant DB as SQLite DB (contexts)

    Judge->>API: POST /v1/context {scope, context_id, version, payload}
    Note over API: Pydantic Validation (ContextPushRequest)
    API->>Store: save_context(scope, context_id, version, payload, delivered_at)
    Store->>DB: SELECT version, payload FROM contexts WHERE scope=? AND context_id=?
    
    alt Existing Context Found & Incoming Version < Stored Version
        DB-->>Store: Stored version = 3, Incoming = 2
        Store-->>API: Conflict: Stale version rejected
        API-->>Judge: HTTP 409 Conflict {detail: "stale_version"}
    else Existing Context Found & Incoming Version == Stored Version
        alt Payload Matches Exactly
            DB-->>Store: Identical payload
            Store-->>API: Idempotent duplicate
            API-->>Judge: HTTP 200 OK {status: "duplicate_ignored", stored_version: 3}
        else Payload Mutated
            DB-->>Store: Mutated payload on same version
            Store-->>API: Conflict: Version payload mutation
            API-->>Judge: HTTP 409 Conflict {detail: "version_conflict"}
        end
    else New Context OR Incoming Version > Stored Version
        Store->>DB: INSERT OR REPLACE INTO contexts (scope, context_id, version, payload, delivered_at)
        DB-->>Store: SQLite row committed (WAL sync)
        Store-->>API: Context Saved
        API-->>Judge: HTTP 200 OK {status: "created" | "updated", stored_version: version}
    end

