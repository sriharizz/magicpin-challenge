%% -----------------------------------------------------------------------------
%% 7. RESILIENT CIRCUIT BREAKER STATE MACHINE
%% -----------------------------------------------------------------------------
stateDiagram-v2
    [*] --> CLOSED: Initial Startup

    state CLOSED {
        [*] --> NormalOperation
        NormalOperation --> Success: Provider Call <= 1500ms
        Success --> NormalOperation: Reset failure_count = 0
        NormalOperation --> Failure: Timeout (>1500ms), 5xx, 429, Net Error
        Failure --> IncrementCount: failure_count += 1
        IncrementCount --> NormalOperation: failure_count < 3
    }

    CLOSED --> OPEN: failure_count >= 3 (Tripped)

    state OPEN {
        [*] --> FailFast
        FailFast --> FastFallback: Incoming Request
        FastFallback --> FailFast: Instant Fallback (0ms, 0 Provider Calls)
    }

    OPEN --> HALF_OPEN: Cooldown Expired (>= 10.0 seconds)

    state HALF_OPEN {
        [*] --> SingleProbe
        SingleProbe --> ProbeCall: Allow exactly 1 test request to provider
    }

    HALF_OPEN --> CLOSED: Probe Succeeded (Reset failure_count = 0)
    HALF_OPEN --> OPEN: Probe Failed (Reset cooldown timer)

