%% -----------------------------------------------------------------------------
%% 9. CONVERSATION STATE MACHINE TRANSITIONS
%% -----------------------------------------------------------------------------
stateDiagram-v2
    [*] --> AWAITING_REPLY: Initial Tick Emission (Turn 1)

    AWAITING_REPLY --> ACTION_MODE: Affirmation ("yes", "ok", "do it", "interested")
    AWAITING_REPLY --> CLARIFYING: Question / Nuanced / Unknown Intent
    AWAITING_REPLY --> AWAITING_REPLY: Turn 2 Auto-Reply (action: 'wait', 14400s)
    AWAITING_REPLY --> TERMINATED_AUTOREPLY: Turn 3+ Auto-Reply (action: 'end')
    AWAITING_REPLY --> TERMINATED_OPT_OUT: Hostile / Opt-Out ("STOP", "unsubscribe")
    AWAITING_REPLY --> TERMINATED_DECLINED: Direct Rejection ("no", "not interested")

    CLARIFYING --> ACTION_MODE: Affirmation ("yes send it")
    CLARIFYING --> CLARIFYING: Follow-up Question
    CLARIFYING --> TERMINATED_OPT_OUT: Opt-Out ("stop messaging")
    CLARIFYING --> TERMINATED_DECLINED: Rejection ("not now")

    ACTION_MODE --> COMPLETED: Follow-up Delivery Concluded
    ACTION_MODE --> TERMINATED_OPT_OUT: Opt-Out
    ACTION_MODE --> TERMINATED_DECLINED: Rejection

    state TerminalLockout {
        TERMINATED_OPT_OUT
        TERMINATED_DECLINED
        TERMINATED_AUTOREPLY
        COMPLETED
    }

    TerminalLockout --> TerminalLockout: Future Turns (action: 'end', body: null, 0ms)

