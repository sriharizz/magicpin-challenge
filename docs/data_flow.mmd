%% 3. /v1/tick PERIODIC TRIGGER FLOW & MULTI-TENANT SUPPRESSION
%% -----------------------------------------------------------------------------
flowchart TD
    StartTick["POST /v1/tick\n(available_triggers, now)"] --> LoadTrg["1. For each trigger in available_triggers\nFetch trigger payload from SQLite"]
    LoadTrg --> CheckExpiry{"2. Is trigger expired?\n(now > expires_at)"}
    CheckExpiry -- YES --> SkipExpired["Drop Trigger\n(Expired)"]
    CheckExpiry -- NO --> ScopeCheck{"3. Trigger Scope Check"}

    ScopeCheck -- merchant --> MerchantLoop["Target Specific Merchant\n(from trigger.merchant_id)"]
    ScopeCheck -- category --> CategoryLoop["Fan out to ALL Merchants\nmatching trigger.category_slug"]

    MerchantLoop --> CheckSupp{"4. Is Suppressed?\nis_suppressed(suppression_key, merchant_id)"}
    CategoryLoop --> CheckSupp

    CheckSupp -- YES: Suppressed --> SkipSupp["Drop Opportunity\n(Suppressed)"]
    CheckSupp -- NO: Active --> GenAction["5. app/engine/composer.py:compose_research_digest()\n- Salutation Voice Fit\n- Word-Boundary Taboo Scrubbing\n- Grounded Digest Formatting"]

    GenAction --> RankQueue["6. Rank Actions by Urgency (High -> Low)\nTie-break: Deterministic ID Order"]
    RankQueue --> Cap20["7. Slice Top 20 Actions (MAX_ACTIONS_PER_TICK)"]
    
    Cap20 --> RecordDB["8. For each emitted action:\n- Record suppression(suppression_key, merchant_id)\n- Initialize conversation(conversation_id, state='AWAITING_REPLY', turn=1)\n- Record turn(turn_number=1, role='bot', message=body)"]
    RecordDB --> EmitTickResp["9. Return TickResponse(actions=[...])"]

%% -----------------------------------------------------------------------------
%% 4. /v1/reply COMPLETE SANDBOXED SANDWICH FLOW
%% -----------------------------------------------------------------------------
flowchart TD
    InboundReply["POST /v1/reply\n{conversation_id, merchant_id, message, turn_number}"] --> ContractVal{"1. Pydantic & Contract Validation\n- Valid conversation_id?\n- from_role in ('merchant', 'customer')?\n- turn_number >= 1?\n- non-empty message?"}
    
    ContractVal -- INVALID --> Http400["HTTP 400 Bad Request"]
    ContractVal -- VALID --> LoadConv["2. Retrieve Conversation Record\napp/store/context_store.py:get_conversation()"]

    LoadConv --> TerminalGate1{"3. Terminal State Lockout (Barrier 1)\nIs state in (TERMINATED_OPT_OUT,\nTERMINATED_DECLINED, TERMINATED_AUTOREPLY, COMPLETED)?"}
    
    TerminalGate1 -- YES: Concluded --> EndFastExit["Return 200 OK\n{action: 'end', body: null, rationale: 'Concluded thread'}\n(0ms latency, 0 LLM calls)"]
    
    TerminalGate1 -- NO: Active --> TurnCheck{"4. Turn Order & Replay Verification"}
    
    TurnCheck -- turn == stored_turn & same msg --> ReplayCache["Return Cached 200 OK\n(Idempotent replay, 0ms)"]
    TurnCheck -- turn == stored_turn & mutated msg --> Http409["HTTP 409 Conflict\n(Turn payload conflict)"]
    TurnCheck -- turn < stored_turn --> Stale400["HTTP 400 Bad Request\n(Stale turn number)"]
    TurnCheck -- turn > stored_turn + 1 --> Skipped400["HTTP 400 Bad Request\n(Skipped turn number)"]
    
    TurnCheck -- VALID NEXT TURN --> ClassifyIntent["5. Intent Classification\napp/engine/intents.py:classify_intent()\n(10-Tier Safety Hierarchy)"]

    ClassifyIntent --> BaselineComp["6. Compute Deterministic Baseline Response\napp/engine/reply_composer.py:compose_reply()"]

    BaselineComp --> PreGateCheck{"7. app/engine/intents.py:should_use_llm()\nIs message nuanced / clinical question?"}

    PreGateCheck -- NO: Fast Exit\n(OPT_OUT, REJECT, AUTO_REPLY, Simple Affirm, Out-of-Scope) --> CommitBarrier
    
    PreGateCheck -- YES: Nuanced Question\n(INTENT_QUESTION, INTENT_UNKNOWN, Complex Affirm) --> BuildEnv["8. Build Minimal Context Envelope\napp/llm/prompts.py:build_context_envelope()"]

    BuildEnv --> CircuitCheck{"9. app/llm/client.py:CircuitBreaker\nCan attempt outbound call?"}

    CircuitCheck -- NO: State is OPEN --> FallbackDet1["Skip LLM -> Adopt Deterministic Baseline\n(0ms latency fail-fast)"]
    
    CircuitCheck -- YES: CLOSED / HALF_OPEN --> CallLLM["10. Execute LLMProvider.generate()\nStrict 1500ms Timeout"]

    CallLLM --> LLMOutcome{"11. LLM Outcome Check"}
    
    LLMOutcome -- Timeout (>1500ms) / 5xx / 429 / Net Error --> RecordFail["Record Circuit Breaker Failure\nAdopt Deterministic Baseline"]
    LLMOutcome -- Valid JSON Returned --> ValidatorGate["12. 11-Point Output Validator\napp/llm/validator.py:LLMOutputValidator.validate()"]

    ValidatorGate -- INVALID (11 checks fail) --> LogValFail["Log Validator Rejection\nAdopt Deterministic Baseline"]
    ValidatorGate -- VALID (All 11 pass) --> AdoptLLM["Adopt Sanitized LLM Suggestion\n(action, body, cta, rationale)"]

    FallbackDet1 --> CommitBarrier
    RecordFail --> CommitBarrier
    LogValFail --> CommitBarrier
    AdoptLLM --> CommitBarrier

    CommitBarrier["13. Terminal State Double Lock (Barrier 2)\nIf state became terminal, force action='end'"] --> SuppressGate{"14. Is Opt-Out or Hostile?"}

    SuppressGate -- YES --> WriteSupp["Record Suppression\n('merchant_opt_out', merchant_id)"]
    SuppressGate -- NO --> SaveDB["15. Commit State to SQLite (WAL ACID)\n- save_conversation(next_state, turn)\n- record_turn(turn_number, action, body)"]

    WriteSupp --> SaveDB
    SaveDB --> Return200["16. Return ReplyResponse (200 OK)"]

