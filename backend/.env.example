# =============================================================================
# magicpin Vera AI Challenge — Environment Configuration Example
# =============================================================================

# Server Binding
HOST=0.0.0.0
PORT=8080
RELOAD=false

# Persistent Storage Path (Recommended to mount a persistent volume at /data)
DB_PATH=/data/magicpin_vera.db

# Metadata
TEAM_NAME=Team Vera Alpha
TEAM_MEMBERS=Vera Engineer
MODEL_NAME=deterministic-phase1
CONTACT_EMAIL=vera-team@magicpin.in
SUBMITTED_AT=2026-08-25T00:00:00Z

# LLM Provider Configuration (Optional: fallback is 100% deterministic & offline-capable)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=1500
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=10.0

# Debug Observability
VERA_DEBUG_TRACE=0
