# =============================================================================
# magicpin Vera AI Challenge — Production Environment Configuration
# =============================================================================

# Server Binding
HOST=0.0.0.0
PORT=8080
RELOAD=false

# Persistent Storage Path (Mount persistent disk at /data)
DB_PATH=/data/magicpin_vera.db

# Metadata
TEAM_NAME=Team Vera Alpha
TEAM_MEMBERS=Vera Engineer
MODEL_NAME=deterministic-phase1
CONTACT_EMAIL=vera-team@magicpin.in
SUBMITTED_AT=2026-08-25T00:00:00Z

# Groq LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# Resilience & Safety Constraints
LLM_TIMEOUT_MS=1500
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=10.0

# Debug Observability
VERA_DEBUG_TRACE=0
